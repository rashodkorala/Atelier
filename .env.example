# Anthropic API key — obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Claude model. Defaults to claude-opus-4-6 (most capable).
# Use claude-sonnet-4-6 for faster, cheaper responses during development.
CLAUDE_MODEL=claude-opus-4-6

# FastAPI host / port
HOST=127.0.0.1
PORT=8000
